# Налаштування бекенду. Скопіюйте у .env командою: npm run setup

PORT=3001
FRONTEND_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:3001

# Підключення до PostgreSQL: postgres://користувач:пароль@сервер:порт/база
DATABASE_URL=postgres://postgres:postgres@localhost:5432/project_manager
# Окрема база для інтеграційних тестів (npm run test:integration)
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/project_manager_test

# Секрети (генеруються автоматично командою npm run setup, не публікуйте їх)
JWT_SECRET=
ENCRYPTION_KEY=

# Тривалість сеансу, хв
ACCESS_TOKEN_TTL_MIN=120

# Захист від brute force: кількість невдалих спроб і тривалість блокування, хв
MAX_FAILED_LOGINS=5
LOCK_MINUTES=15
# Термін дії посилань з листів
ACTIVATION_TTL_HOURS=24
RESET_TTL_MINUTES=30

# Пошта. Якщо SMTP_HOST порожній, листи виводяться в консоль і зберігаються в папку mail-outbox.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true,
#        SMTP_USER=ваша.пошта@gmail.com, SMTP_PASS=пароль застосунку (16 символів)
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Project Manager <no-reply@project-manager.local>

# Вхід через Google (OpenID Connect). Redirect URI у Google Cloud Console:
# http://localhost:3001/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Кількість проксі-серверів перед API (1 — якщо запускаєте за Nginx з HTTPS)
TRUST_PROXY=0
